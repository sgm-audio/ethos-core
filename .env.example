# ETHOS Core Environment Configuration

# Application
LOG_LEVEL=DEBUG
DEBUG=True

# Database
POSTGRES_USER=ethos
POSTGRES_PASSWORD=ethos_dev_password
POSTGRES_DB=ethos_core
DATABASE_URL=postgresql://ethos:ethos_dev_password@postgres:5432/ethos_core

# Redis
REDIS_URL=redis://redis:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Audio Processing
AUDIO_SAMPLE_RATE=44100
AUDIO_CHUNK_SIZE=4096

# Ray Configuration
RAY_CLUSTER_HOST=localhost
RAY_CLUSTER_PORT=6379
